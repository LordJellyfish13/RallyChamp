**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Internal working notes (not part of the submitted project)
dev_notes.md

# Push endpoint. The service-account key is a master key to the whole
# Firebase project — it lives in a Wrangler secret, never in the repo.
# These patterns are a safety net in case one gets downloaded in here.
push-endpoint/node_modules/
push-endpoint/.wrangler/
**/serviceAccount*.json
**/*-firebase-adminsdk-*.json
