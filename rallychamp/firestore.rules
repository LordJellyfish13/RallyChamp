rules_version = '2';

// Anything not explicitly matched below is denied by default — that's
// Firestore's normal behavior, not something we have to write ourselves.
// Extend this file collection-by-collection as each feature is built
// (see dev_notes.md §9 for the full planned schema).
service cloud.firestore {
  match /databases/{database}/documents {

    // News feed: publicly readable (guest access, no login required).
    // Created either by the rally-publish flow (rallyId set, checked against
    // that rally's adminUids) — no other client write path yet.
    match /news/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.rallyId != null
        && request.auth.uid in get(
          /databases/$(database)/documents/rallies/$(request.resource.data.rallyId)
        ).data.adminUids;
      allow update, delete: if false;
    }

    // Rallies: public once published, otherwise only visible to their
    // admins. Anyone signed in can create one and becomes its sole admin —
    // there's no separate "become an organizer" gate yet (see dev_notes.md
    // §5). Stages always exist (even for single-stage rallies) and inherit
    // the parent rally's read access; no stage editing UI yet so
    // create-only.
    match /rallies/{rallyId} {
      allow read: if resource.data.visibility == 'published'
        || (request.auth != null && request.auth.uid in resource.data.adminUids);
      allow create: if request.auth != null
        && request.resource.data.adminUids.hasOnly([request.auth.uid])
        && request.resource.data.status == 'setup';
      allow update: if request.auth != null && request.auth.uid in resource.data.adminUids;
      allow delete: if false;

      match /stages/{stageId} {
        allow read: if get(/databases/$(database)/documents/rallies/$(rallyId)).data.visibility == 'published'
          || (request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids);
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids;
        // Route drawing/recording (dev_notes.md §5 "Route creation") is the
        // only stage edit built so far, so this is deliberately narrow —
        // an admin can only touch `route`, nothing else on the document.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['route']);
        allow delete: if false;
      }

      // Checkpoints (viewing/parking/box points, code like "R13"). Same
      // read visibility as stages; admins can create and edit (fixing a
      // typo'd code shouldn't need a delete+recreate).
      match /checkpoints/{checkpointId} {
        allow read: if get(/databases/$(database)/documents/rallies/$(rallyId)).data.visibility == 'published'
          || (request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids);
        allow create, update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids;
        allow delete: if false;
      }
    }

    // Personal profile: name, phone, OIB, judge license. Self-access only
    // for now — organizer/admin read (to review applications) is a
    // deliberately deferred rule, added once the review UI exists and can
    // check a rally's adminUids.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Marshal/judge applications. Applicant can file and read their own;
    // that rally's admins can read all of them (to review) and update only
    // status/assignedCheckpointId (to accept/reject/assign) — nothing else
    // on the document, so an admin can't rewrite the applicant's own
    // claimed name/phone.
    //
    // A marshal application (never judge) may self-submit as already
    // 'accepted' — the walk-up-marshal case — but only if the rally is
    // genuinely live right now and its organizer has left walk-up marshals
    // enabled; both checked here against the real rally document, not
    // trusted from the client. See dev_notes.md §5 "Walk-up marshals
    // during a live rally".
    match /rallies/{rallyId}/staffApplications/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids);

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.roleRequested in ['marshal', 'judge']
        && request.resource.data.applicantName is string
        && request.resource.data.applicantPhone is string
        && (
          request.resource.data.status == 'pending'
          || (
            request.resource.data.status == 'accepted'
            && request.resource.data.roleRequested == 'marshal'
            && get(/databases/$(database)/documents/rallies/$(rallyId)).data.allowWalkupMarshals == true
            && get(/databases/$(database)/documents/rallies/$(rallyId)).data.status in ['running', 'start', 'paused', 'lunch break']
          )
        );

      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedCheckpointId'])
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    // Team/competitor entries. Public fields (car number, class, team/driver
    // name) are readable once the rally is published — entry lists are
    // meant to be public per dev_notes.md §5 — or always visible to that
    // rally's admins. Contact info stays in the private subdoc, self-access
    // only.
    match /rallies/{rallyId}/entries/{uid} {
      allow read: if get(/databases/$(database)/documents/rallies/$(rallyId)).data.visibility == 'published'
        || (request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rallies/$(rallyId)).data.adminUids);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;

      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

  }
}
